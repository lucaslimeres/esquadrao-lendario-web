# URL da API (esquadrao-lendario-api)
VITE_API_URL=http://localhost:3333

# Links do app nas lojas. Vazio = mostra "Em breve" na landing page.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Google AdSense (ver README). Sem o client id, nenhum anúncio nem script do Google é carregado.
# ID de editor: ca-pub-0000000000000000 (aceita também pub-...). Gera também /ads.txt e a meta de verificação.
VITE_ADSENSE_CLIENT=
# Um bloco de anúncios (display) por posição. Vazio = aquela posição não mostra anúncio.
VITE_ADSENSE_SLOT_LANDING=
VITE_ADSENSE_SLOT_FIM_CAMPANHA=
VITE_ADSENSE_SLOT_COMPARTILHADA=
VITE_ADSENSE_SLOT_MINHAS_CAMPANHAS=
# 1 = mostra um bloco cinza onde os anúncios vão aparecer (só para conferir o layout localmente).
VITE_ADSENSE_PREVIA=
